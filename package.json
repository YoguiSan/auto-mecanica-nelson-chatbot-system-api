{
  "name": "chatbot-system-backend",
  "version": "1.0.0",
  "description": "System API para a AMS, que comunica-se com a ferramenta de IA",
  "license": "ISC",
  "author": "Nelson Salles de Barros Filho",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config=jest.config.mjs",
    "dev": "nodemon ./src/index.ts",
    "dev:mock": "MOCK_AI_RESPONSES=true nodemon ./src/index.ts",
    "lint": "npx eslint .",
    "build": "npx esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.cjs",
    "start:local": "pm2-runtime start ecosystem.config.cjs",
    "start": "pm2-runtime start prod-ecosystem.config.cjs",
    "stop": "pm2-runtime stop amn-chatbot-system-api",
    "set:agent": "mkdir .github & mkdir .github/agents & cp \"../ai-agents/backend/Node.js backend.agent.md\" .github/agents/AGENTS.md"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "commitizen": "^4.2.4",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.0.0",
    "jest": "^30.4.2",
    "jest-cli": "^30.4.2",
    "nock": "^14.0.15",
    "nodemon": "^3.1.11",
    "pm2-runtime": "^5.4.1",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "openai": "^6.42.0",
    "overmind": "^28.2.1",
    "winston": "^3.19.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
